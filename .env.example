# Public environment variables (exposed to the client)

# Custom header used for authentication or API requests
NEXT_PUBLIC_CUSTOM_HEADER="sbc@b3ebAbcD3fG!@#1XyZ$%KlmN78&O"

# Base URL for the backend API or gateway
NEXT_PUBLIC_BASE_URL= "https://api-gateway-service-production-2e85.up.railway.app/smarte"
# The base URL for the API gateway service

# MQTT WebSocket bridge URL (browser connects here)
NEXT_PUBLIC_MQTT_WS_URL="ws://localhost:8080"

# MQTT broker TCP URL (bridge connects here, server-side only)
MQTT_BROKER_URL="mqtt://iot.memmserve.com:1883"

# MQTT WebSocket bridge port (server-side only)
MQTT_WS_PORT=8080